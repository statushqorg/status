{
  "name": "@statushq/agent",
  "version": "0.1.0",
  "description": "Report host metrics and application health to StatusHQ from any Bun or Node app — push, pull, or both.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "statushq-agent": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun run build.ts && bunx --bun tsc -p tsconfig.build.json",
    "test": "bun test ../../tests/unit/agent-cli.test.ts ../../tests/unit/agent-package.test.ts ../../tests/unit/agent-metrics.test.ts ../../tests/unit/sdk-compatibility.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "keywords": ["monitoring", "health-check", "metrics", "statushq", "uptime", "cgroup"],
  "license": "MIT",
  "engines": { "bun": ">=1.0.0", "node": ">=18.15.0" }
}
