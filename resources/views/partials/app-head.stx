<!--
  Shared head assets for every post-login dashboard page, replacing the
  earlier telemetry-head.stx experiment: the app now speaks the SAME
  design language as the marketing site (emerald accent, Space Grotesk
  display, Inter body, JetBrains Mono for telemetry values, light AND
  dark with the persisted toggle) so signing in never feels like
  switching products. The tokens used to be copied here from index.stx /
  partials/marketing-head.stx, with a note asking that they stay in sync;
  they are declared once in config/crosswind.ts now, so there is nothing
  left to keep in sync.

  Corner-radius rule (one system, documented): containers 16px
  (--radius), inputs/buttons 10px (--radius-sm), chips/pills/dots full.

  Expects nothing from the including page. The nav bar (app-nav.stx)
  expects AUTH_USER and NAV_ACTIVE, which every dashboard page defines.
  NOTE: never write a literal script tag inside these comments, and the
  theme pre-paint script must not be the partial's first element (both
  stx parser constraints; see marketing-head.stx).
-->
{{-- Favicons, font preconnects and the font stylesheet moved to
     config/ui.ts app.head (stx-standards 04-head); dashboard pages are
     fragments, so the document shell merges them into the generated
     head. --}}
{{-- No <style> block: rule 3 / §11.1. This partial's 157 rules are
     config/crosswind.ts's `appCss()` preflight, wrapped once in the layout
     group this app's pages are served under -- `default` -- because a
     preflight reaches every page and forty class names in this app mean
     different things on different surfaces. The design tokens went to
     `paletteCss()` in the same file.

     What is left here is the pre-paint theme script, which has to stay inline
     and has to run before first paint. --}}
{{-- Scripts sit AFTER the style block on purpose: a script as the
     partial's FIRST element is treated as its component script and
     stripped from the output (the deleted font links used to shield
     them; the style block shields them now). --}}
<script src="/assets/scripts/csrf-forms.js" defer></script>
{{-- The pre-paint theme script is app.colorMode in config/ui.ts now. --}}

<script>
  // Chart tooltips: every .chart-hit rect carries data-tip; a single
  // floating div follows the cursor across all charts on the page. The
  // optional data-cx/cy pins a marker dot onto line charts.
  (function () {
    var tip = document.createElement('div')
    tip.className = 'chart-tip'
    document.body.appendChild(tip)
    document.addEventListener('mousemove', function (e) {
      var hit = e.target && e.target.classList && e.target.classList.contains('chart-hit') ? e.target : null
      var marker = hit && hit.parentElement ? hit.parentElement.querySelector('.chart-marker') : null
      if (!hit) {
        tip.style.display = 'none'
        var stale = document.querySelectorAll('.chart-marker')
        for (var i = 0; i < stale.length; i++) stale[i].setAttribute('opacity', '0')
        return
      }
      tip.textContent = hit.getAttribute('data-tip') || ''
      tip.style.display = 'block'
      var x = e.clientX + 12
      var y = e.clientY - 34
      if (x + tip.offsetWidth > window.innerWidth - 8) x = e.clientX - tip.offsetWidth - 12
      tip.style.left = x + 'px'
      tip.style.top = Math.max(8, y) + 'px'
      if (marker && hit.getAttribute('data-cx')) {
        marker.setAttribute('cx', hit.getAttribute('data-cx'))
        marker.setAttribute('cy', hit.getAttribute('data-cy'))
        marker.setAttribute('opacity', '1')
      }
    }, { passive: true })
  })()
</script>

<script>
  // Copy buttons on every .code-block. Each one is a command meant to be run on
  // another machine, so the thing the page most often wants is the text on a
  // clipboard rather than selected by hand across a wrapped line.
  //
  // Same shape as the chart tooltip above: one delegated listener rather than a
  // handler per button, so blocks added to a page later are covered too.
  (function () {
    function legacyCopy(text) {
      var ta = document.createElement('textarea')
      ta.value = text
      ta.setAttribute('readonly', '')
      ta.style.position = 'fixed'
      ta.style.top = '-1000px'
      document.body.appendChild(ta)
      ta.select()
      var ok = false
      try { ok = document.execCommand('copy') } catch (_e) { ok = false }
      document.body.removeChild(ta)
      return ok
    }

    var blocks = document.querySelectorAll('pre.code-block')
    for (var i = 0; i < blocks.length; i++) {
      var pre = blocks[i]
      if (pre.parentElement && pre.parentElement.classList.contains('code-wrap')) continue
      var wrap = document.createElement('div')
      wrap.className = 'code-wrap'
      pre.parentNode.insertBefore(wrap, pre)
      wrap.appendChild(pre)
      var btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'copy-btn'
      btn.textContent = 'Copy'
      // The label is the status too, so it is announced when it changes rather
      // than silently becoming "Copied" for sighted users only.
      btn.setAttribute('aria-live', 'polite')
      wrap.appendChild(btn)
    }

    document.addEventListener('click', function (event) {
      var btn = event.target && event.target.closest ? event.target.closest('.copy-btn') : null
      if (!btn) return
      var pre = btn.parentElement && btn.parentElement.querySelector('pre.code-block')
      if (!pre) return

      var settle = function (ok) {
        // Never claim a copy that did not happen: a denied clipboard permission
        // leaves the operator pasting nothing into a root shell.
        btn.textContent = ok ? 'Copied' : 'Press \u2318C'
        setTimeout(function () { btn.textContent = 'Copy' }, 1600)
      }

      var text = pre.textContent || ''
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(
          function () { settle(true) },
          function () { settle(legacyCopy(text)) },
        )
      }
      else {
        settle(legacyCopy(text))
      }
    })
  })()
</script>
