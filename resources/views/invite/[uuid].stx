<script server>
import { db } from '@stacksjs/database'

// Browser-facing team-invite acceptance page. The invite email links here
// (/invite/{uuid}); the form posts to /api/invite-forms/{uuid}/accept
// (AcceptInviteFormAction), which links or creates the user, activates the
// membership, and signs them in. Public page (the uuid is the capability),
// so there is no auth/team resolution here.
//
// Reads through @stacksjs/database like every other view. It used to open
// `bun:sqlite` directly against DB_DATABASE_PATH, on a comment claiming that
// was "the same convention as the public status pages" -- which it was not:
// status/[slug].stx and index.stx both use this same `db`. The direct handle
// hardcoded a local SQLite file, so on the networked-Postgres hosted setup
// this page could not read anything and every invite link died on arrival.
// It fails for the invited person, on a page the person who sent the invite
// never loads, which is about the worst place to put a portability bug.
//
// Rendered as a FRAGMENT (no <!DOCTYPE>/<html>/<head>/<body>) like every
// other dynamic view in this app: a full-document dynamic view trips a
// serve-path render hang, and the shared serve shell supplies the document
// chrome anyway. Title + favicon come from useHead; the theme pre-paint
// and styles live inline in the fragment body (same as the dashboard's
// app-head partial, which is also fragment-injected).
const appName = process.env.APP_NAME || 'StatusHQ'

const inviteUuid = (typeof uuid !== 'undefined' && uuid) ? String(uuid) : ''
const member = inviteUuid
  ? await db.selectFrom('team_members').where('uuid', '=', inviteUuid)
    .select(['id', 'team_id', 'invited_email', 'role', 'status']).executeTakeFirst()
  : null

const team = member
  ? await db.selectFrom('teams').where('id', '=', member.team_id).select(['name']).executeTakeFirst()
  : null

const existingUser = member
  ? await db.selectFrom('users').where('email', '=', String(member.invited_email || '').toLowerCase())
    .select(['id']).executeTakeFirst()
  : null
const hasAccount = !!existingUser

const state = !member
  ? 'invalid'
  : member.status === 'active'
    ? 'accepted'
    : member.status !== 'pending'
      ? 'invalid'
      : 'pending'

const teamName = team ? team.name : 'a team'
const invitedEmail = member ? member.invited_email : ''
const role = member ? member.role : 'member'
const acceptHint = hasAccount
  ? 'Sign in with your existing password to accept.'
  : 'Create your account to accept and view the dashboard.'

const query = (typeof __stxServeSearch !== 'undefined' && __stxServeSearch) ? new URLSearchParams(__stxServeSearch) : new URLSearchParams()
const errorCode = query.get('error') || ''
const ERROR_MESSAGES = {
  bad_credentials: 'That password does not match the existing account for this email. Enter your current password to accept.',
  weak_password: 'Password must be at least 6 characters.',
  name_required: 'Please enter your name.',
  register_failed: 'Something went wrong creating your account. Please try again.',
  invalid: 'This invite is no longer valid.',
}
const errorMessage = ERROR_MESSAGES[errorCode] || ''

useHead({
  title: `Join ${teamName} · ${appName}`,
  meta: [{ name: 'robots', content: 'noindex' }],
  link: [
    { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' },
    { rel: 'icon', href: '/favicon-32.png', type: 'image/png', sizes: '32x32' },
    { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
  ],
})
</script>

{{-- <main> is the router's container, and this page is the one view in the
    app that had no element to be it. It has no layout, so it falls into the
    layout group 'default' alongside the whole dashboard.

    It carries a class, and that is not decoration. The layout rules below --
    min-height, display:grid, place-items, padding -- were moved off `body`
    onto `main` precisely because they are four properties the dashboard's own
    body rule never sets, so nothing would have stopped them applying to the
    whole app. In one shared sheet a bare `main` is that same bug one element
    down: it grid-centred every dashboard page's <main> until this class went
    on. The rules are `main.invite-shell` in config/crosswind.ts. --}}
<main class="invite-shell">
{{-- No <style> block: rule 3 / §11.1 -- see `dashboardPagesCss()` in
     config/crosswind.ts.

     This page is a fragment with no @include, so it never shipped the
     dashboard sheet; being in the `default` layout group, it gets it now.
     Everything it declares is under `.invite-card` and so outranks that
     sheet, and the three places the sheet set a property this page did not
     -- the CTA's hover border, and line-height on .brand-name and .help --
     are restated there so the page looks exactly as it did. --}}

<div class="invite-card">
  <StxLink class="brand" to="/">
    <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12h3.5l2-5 3 10 2-7 1.5 3.5h6.5"/></svg></span>
    <span class="brand-name">{{ appName }}</span>
  </StxLink>

  @if (state === 'invalid')
    <h1>Invite not found</h1>
    <p class="sub">This invite link is invalid or has already been used. Ask whoever invited you to send a fresh one.</p>
    <StxLink class="button" to="/login">Go to sign in</StxLink>
  @endif

  @if (state === 'accepted')
    <h1>You're already in</h1>
    <p class="sub">This invite to <strong>{{ teamName }}</strong> has already been accepted. Sign in to view the dashboard.</p>
    <StxLink class="button" to="/login">Sign in</StxLink>
  @endif

  @if (state === 'pending')
    @if (errorMessage)
      <div id="form-error" class="error" role="alert">{{ errorMessage }}</div>
    @endif

    <h1>Join {{ teamName }}</h1>
    <p class="sub">You've been invited to <strong>{{ teamName }}</strong> as<span class="role-pill">{{ role }}</span>. {{ acceptHint }}</p>

    <form method="POST" action="/api/invite-forms/{{ inviteUuid }}/accept">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" value="{{ invitedEmail }}" disabled>
      </div>
      @if (!hasAccount)
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" placeholder="First and last name" required aria-invalid="{{ errorMessage ? 'true' : 'false' }}"@if (errorMessage) aria-describedby="form-error"@endif>
        </div>
      @endif
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="{{ hasAccount ? 'current-password' : 'new-password' }}" placeholder="{{ hasAccount ? 'Your existing password' : 'At least 6 characters' }}" minlength="6" required aria-invalid="{{ errorMessage ? 'true' : 'false' }}"@if (errorMessage) aria-describedby="form-error"@endif>
        @if (!hasAccount)
          <p class="help">This becomes your password for signing in.</p>
        @endif
      </div>
      <button class="button" type="submit">Accept invite &amp; continue</button>
    </form>

    <p class="alt">Not you? <StxLink to="/">Ignore this invite</StxLink></p>
  @endif
</div>
</main>
