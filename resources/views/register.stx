<script server>
const appName = process.env.APP_NAME || 'StatusHQ'

// SSO providers, mirroring config/sso.ts's env contract (this view is
// self-contained by the app's convention, so it reads env directly
// rather than importing the config). A provider appears as a button
// only when fully configured. Signup and login share the same flow:
// the callback provisions an account when the identity is new.
const ssoProviders = []
if ((process.env.GOOGLE_CLIENT_ID || process.env.SSO_GOOGLE_CLIENT_ID) && (process.env.GOOGLE_CLIENT_SECRET || process.env.SSO_GOOGLE_CLIENT_SECRET))
  ssoProviders.push({ key: 'google', label: 'Google' })
if (process.env.APPLE_CLIENT_ID && process.env.APPLE_TEAM_ID && process.env.APPLE_KEY_ID && process.env.APPLE_PRIVATE_KEY)
  ssoProviders.push({ key: 'apple', label: 'Apple' })
if (process.env.GITHUB_CLIENT_ID && process.env.GITHUB_CLIENT_SECRET)
  ssoProviders.push({ key: 'github', label: 'GitHub' })
if (process.env.SSO_OKTA_ISSUER && process.env.SSO_OKTA_CLIENT_ID && process.env.SSO_OKTA_CLIENT_SECRET)
  ssoProviders.push({ key: 'okta', label: 'Okta' })
if (process.env.SSO_ENTRA_TENANT_ID && process.env.SSO_ENTRA_CLIENT_ID && process.env.SSO_ENTRA_CLIENT_SECRET)
  ssoProviders.push({ key: 'entra', label: 'Microsoft' })
if (process.env.SSO_OIDC_ISSUER && process.env.SSO_OIDC_CLIENT_ID && process.env.SSO_OIDC_CLIENT_SECRET)
  ssoProviders.push({ key: 'oidc', label: process.env.SSO_OIDC_LABEL || 'SSO' })
const hasSso = ssoProviders.length > 0

// Head via useHead, not useSeoMeta (stx-standards 04): auth surfaces
// are noindex, so deriving og/twitter tags for them would be noise.
useHead({
  title: "Create your account \u00b7 " + appName,
  meta: [
    { name: 'description', content: "Create a free StatusHQ account and put your first monitor live in minutes." },
    { name: 'robots', content: 'noindex' },
  ],
})
</script>


<script client>
// Creating an account, as stx client code rather than the DOM-walking script
// this used to be (stx-standards rule 8). The same conversion as login.stx,
// which carries the longer note on why each replacement is the one it is;
// this page is the simpler half -- one form, no second step, no passkey.
//
// `error` owns the banner and the three aria-invalid attributes, `loading`
// owns the button. Nothing is found by id.
//
// useCookie('X-CSRF-Token') replaces the hand-rolled readCookie plus
// document.cookie serialiser. It is the same cookie this app's login page
// mints, with the same attributes -- path=/, SameSite=Lax, and Secure only on
// https -- because the composable's defaults are exactly what both pages used
// to spell out.
//
// navigate(REDIRECT, { reload: true }) replaces `window.location.href =`: a
// bare navigate() hands the call to the client router, which swaps a fragment
// and keeps the surrounding document, and a new account should land in the
// onboarding shell rather than inside the auth one.
const REDIRECT = '/dashboard/onboarding'

const error = state('')
const loading = state(false)

const csrf = useCookie('X-CSRF-Token')

/**
 * Double-submit CSRF token, self-seeded when the view server did not set one.
 * See resources/views/login.stx for the full rationale.
 */
function ensureCsrf(): string {
  const existing = csrf()
  if (existing)
    return existing

  const bytes = new Uint8Array(32)
  crypto.getRandomValues(bytes)
  const token = Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('')
  csrf.set(token)
  return token
}

/** What POST /register answers with. */
interface RegisterResponse {
  token?: string
  message?: string
  error?: string
  errors?: Record<string, string | string[]>
}

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither carries a `.value`.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

/** The first message out of a validation error map, if there is one. */
function firstValidationMessage(errors: Record<string, string | string[]> | undefined): string {
  if (!errors)
    return ''
  const firstKey = Object.keys(errors)[0]
  if (!firstKey)
    return ''
  const value = errors[firstKey]
  return Array.isArray(value) ? String(value[0] ?? '') : String(value ?? '')
}

async function handleSubmit(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return
  const form = event.target
  if (!(form instanceof HTMLFormElement))
    return

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/register', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': ensureCsrf() },
      body: JSON.stringify({
        name: fieldValue(form, 'name').trim(),
        email: fieldValue(form, 'email').trim(),
        password: fieldValue(form, 'password'),
      }),
    })

    let data: RegisterResponse = {}
    try {
      data = await res.json() as RegisterResponse
    }
    catch {
      data = {}
    }

    if (res.ok && data.token) {
      navigate(REDIRECT, { reload: true })
      return
    }
    error.set(data.message || data.error || firstValidationMessage(data.errors) || 'Could not create your account. Please try again.')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('layouts/auth')

@section('content')
    <div class="auth-card">
      <StxLink class="brand" to="/">
        <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12h3.5l2-5 3 10 2-7 1.5 3.5h6.5"/></svg></span>
        <span class="brand-name">{{ appName }}</span>
      </StxLink>

      <div id="error" :class="error() ? 'error show' : 'error'" role="alert">{{ error() }}</div>

      <form @submit="handleSubmit">
        <h1>Create your account</h1>
        <p class="sub">Start monitoring in under two minutes. No credit card required.</p>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" :aria-invalid="error() ? 'true' : 'false'" type="text" autocomplete="name" placeholder="Ada Lovelace" required aria-describedby="error">
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" :aria-invalid="error() ? 'true' : 'false'" type="email" autocomplete="email" placeholder="you@yourcompany.com" required aria-describedby="error">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" :aria-invalid="error() ? 'true' : 'false'" type="password" autocomplete="new-password" placeholder="Create a password" minlength="6" required aria-describedby="error">
          <p class="hint">At least 6 characters.</p>
        </div>
        <button class="button" type="submit" :disabled="loading()">{{ loading() ? 'Creating account…' : 'Create account' }}</button>

        @if (hasSso)
          <div class="sso-divider">or</div>
          <div class="sso-buttons">
            @foreach (ssoProviders as p)
              <a class="button sso" href="/api/auth/sso/{{ p.key }}" data-no-router><span class="sso-icon sso-icon-{{ p.key }}"></span>Continue with {{ p.label }}</a>
            @endforeach
          </div>
        @endif
      </form>

      <p class="alt">Already have an account? <StxLink to="/login">Sign in</StxLink></p>
    </div>

@endsection
