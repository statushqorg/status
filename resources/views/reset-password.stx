<script server>
// Step two of a password reset: set the new one.
//
// This is the page config/auth.ts `passwordReset.url` points at. If the two
// ever disagree, a valid token lands on a 404 and reads as a broken link rather
// than a misrouted one, which is the worst version of this failure because the
// person retries the same dead link instead of asking for a fresh one.
useSeoMeta({
  title: 'Set a new password - StatusHQ',
  description: 'Choose a new password for your StatusHQ account.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// POST /password/reset with the token from the URL.
const error = state('')
const done = state(false)
const loading = state(false)

const token = state('')
const email = state('')
// 'checking' until verify-token answers, then 'valid' or 'invalid'. The form is
// withheld until then: letting somebody choose and confirm a password against a
// dead token wastes the one thing they came here to do.
const linkState = state('checking')

const csrf = useCookie('X-CSRF-Token')

/** Same double-submit CSRF as login.stx and the forgot page; see the note there. */
function ensureCsrf(): string {
  const existing = csrf()
  if (existing)
    return existing

  const bytes = new Uint8Array(32)
  crypto.getRandomValues(bytes)
  const token = Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('')
  csrf.set(token)
  return token
}

function fieldValue(form: HTMLFormElement, name: string): string {
  const element = form.elements.namedItem(name)
  return element instanceof HTMLInputElement ? element.value : ''
}

/** What /password/reset answers with. */
interface ResetResponse {
  message?: string
}

onMount(() => {
  const params = useSearchParams()
  const t = params.get('token') || ''
  const e = params.get('email') || ''
  token.set(t)
  email.set(e)

  if (!t || !e) {
    linkState.set('invalid')
    return
  }

  fetch('/password/verify-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-csrf-token': ensureCsrf() },
    body: JSON.stringify({ token: t, email: e }),
  })
    // Only the action's own verdicts condemn a link: 400 for expired or already
    // used, 422 for malformed. A 5xx is this server failing, and `fetch` does
    // not reject on one, so `r.ok` alone tells people their link expired
    // whenever our own side is down, and sends them off to request another that
    // cannot arrive either. Offering the form instead costs nothing: the reset
    // re-verifies, so nothing is ever trusted on this answer.
    .then((r: Response) => { linkState.set(r.ok || r.status >= 500 ? 'valid' : 'invalid') })
    // Same for a transport failure, which is not a verdict at all.
    .catch(() => { linkState.set('valid') })
})

async function handleSubmit(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return

  const form = event.target as HTMLFormElement
  const password = fieldValue(form, 'password')
  const confirmation = fieldValue(form, 'password_confirmation')

  // Both are re-checked server side. They are here so a typo answers instantly
  // instead of spending a round trip, and so the mismatch message is about the
  // field rather than about the token.
  if (password !== confirmation) {
    error.set('Those two passwords do not match.')
    return
  }

  if (password.length < 8) {
    error.set('Use at least 8 characters.')
    return
  }

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/password/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': ensureCsrf() },
      body: JSON.stringify({
        email: email(),
        token: token(),
        password,
        password_confirmation: confirmation,
      }),
    })

    if (res.ok) {
      done.set(true)
      return
    }

    const data = (await res.json().catch(() => ({}))) as ResetResponse
    error.set(data.message || 'That reset link is not valid or has expired.')
  }
  catch {
    error.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('layouts/auth')

@section('content')
    <div class="auth-card">
      <StxLink class="brand" to="/">
        <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12h3.5l2-5 3 10 2-7 1.5 3.5h6.5"/></svg></span>
        <span class="brand-name">{{ appName }}</span>
      </StxLink>

      <div id="error" :class="error() ? 'error show' : 'error'" role="alert">{{ error() }}</div>

      <div :class="done() ? '' : 'hide'">
        <h1>Password changed</h1>
        {{-- No automatic redirect. The reset signs every other session out, so
             arriving at a sign-in form unannounced reads as the reset failing. --}}
        <p class="sub">You can sign in with it now.</p>
        <StxLink class="button" to="/login">Sign in</StxLink>
      </div>

      <div :class="!done() && linkState() === 'checking' ? '' : 'hide'">
        <h1>Checking your link</h1>
        <p class="sub">One moment.</p>
      </div>

      <div :class="!done() && linkState() === 'invalid' ? '' : 'hide'">
        <h1>That link has expired</h1>
        <p class="sub">
          Reset links are good for 60 minutes and can only be used once. Ask for
          a fresh one and it will work.
        </p>
        <StxLink class="button" to="/forgot-password">Request a new link</StxLink>
      </div>

      <form :class="!done() && linkState() === 'valid' ? '' : 'hide'" @submit="handleSubmit">
        <h1>Set a new password</h1>
        <p class="sub">At least 8 characters.</p>

        {{-- Present so a password manager knows which account it is saving
             against. The person cannot edit it; the token is bound to it. --}}
        <input type="hidden" name="email" :value="email()" autocomplete="username">

        <div class="field">
          <label for="password">New password</label>
          <input id="password" name="password" :aria-invalid="error() ? 'true' : 'false'" type="password" autocomplete="new-password" minlength="8" required aria-describedby="error">
        </div>
        <div class="field">
          <label for="password_confirmation">Confirm new password</label>
          <input id="password_confirmation" name="password_confirmation" :aria-invalid="error() ? 'true' : 'false'" type="password" autocomplete="new-password" minlength="8" required aria-describedby="error">
        </div>
        <button class="button" type="submit" :disabled="loading()" :aria-busy="loading()">{{ loading() ? 'Saving…' : 'Save new password' }}</button>
      </form>
    </div>
@endsection
