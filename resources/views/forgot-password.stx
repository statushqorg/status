<script server>
// Step one of a password reset: ask for the address.
//
// Before this page existed, /forgot-password answered 200 with the 44 KB
// marketing homepage, because the catch-all served it. A soft 404 on an account
// recovery path is worse than a hard one: it looks like the feature is there.
useSeoMeta({
  title: 'Reset your password - StatusHQ',
  description: 'Request a password reset link for your StatusHQ account.',
  // Auth-adjacent and single-purpose. A crawler following it only spends the
  // rate limiter.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// POST /password/forgot, then replace the form with a confirmation.
//
// ## Why only 429 is surfaced
//
// SendPasswordResetEmailAction returns one constant on every path - known
// address, unknown address, and a send that threw - and holds that in a single
// NEUTRAL_RESPONSE so a future branch cannot quietly reintroduce the leak. This
// page must not undo that. Branching on anything a stranger can observe rebuilds
// the account-existence oracle the action was written to avoid.
//
// 429 stays visible. A rate limit is a fact about the person asking, not about
// whether somebody else holds an account, and swallowing it strands them waiting
// on an email that was never queued.
const error = state('')
const sent = state(false)
const loading = state(false)

const csrf = useCookie('X-CSRF-Token')

/**
 * Double-submit CSRF, lifted from login.stx because this page has the same
 * problem: the view server does not seed the token cookie, only the API router
 * does on its own GET responses, so a page rendered by `buddy serve` has none.
 * The token is not a server secret - the middleware only checks that the cookie
 * equals the echoed header - so minting one here is safe. Without it this
 * endpoint answers 403 and the form appears broken for everyone.
 */
function ensureCsrf(): string {
  const existing = csrf()
  if (existing)
    return existing

  const bytes = new Uint8Array(32)
  crypto.getRandomValues(bytes)
  const token = Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('')
  csrf.set(token)
  return token
}

/** Reading an uncontrolled field: `form.elements` hands back Elements, which carry no value. */
function fieldValue(form: HTMLFormElement, name: string): string {
  const element = form.elements.namedItem(name)
  return element instanceof HTMLInputElement ? element.value : ''
}

/** What /password/forgot answers with. */
interface ForgotResponse {
  message?: string
}

async function handleSubmit(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return

  const form = event.target as HTMLFormElement
  const email = fieldValue(form, 'email').trim()

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/password/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': ensureCsrf() },
      body: JSON.stringify({ email }),
    })

    if (res.status === 429) {
      const data = (await res.json().catch(() => ({}))) as ForgotResponse
      error.set(data.message || 'Too many attempts. Please try again in a few minutes.')
      return
    }

    sent.set(true)
  }
  catch {
    // A transport failure is about this request rather than about the account,
    // so it is safe to name. Claiming "sent" here would cost somebody their
    // recovery.
    error.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('layouts/auth')

@section('content')
    <div class="auth-card">
      <StxLink class="brand" to="/">
        <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12h3.5l2-5 3 10 2-7 1.5 3.5h6.5"/></svg></span>
        <span class="brand-name">{{ appName }}</span>
      </StxLink>

      <div id="error" :class="error() ? 'error show' : 'error'" role="alert">{{ error() }}</div>

      {{-- Confirmation and form are separate branches rather than one element
           whose label changes: the form must not linger under a success
           message, and a second submit is only another email. --}}
      <div :class="sent() ? '' : 'hide'">
        <h1>Check your inbox</h1>
        <p class="sub">
          If that email has an account, a reset link is on its way. The link is
          good for 60 minutes.
        </p>
        <StxLink class="button" to="/login">Back to sign in</StxLink>
      </div>

      <form :class="sent() ? 'hide' : ''" @submit="handleSubmit">
        <h1>Reset your password</h1>
        <p class="sub">We will email you a link to set a new one.</p>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" :aria-invalid="error() ? 'true' : 'false'" type="email" autocomplete="email" placeholder="you@yourcompany.com" required aria-describedby="error">
        </div>
        <button class="button" type="submit" :disabled="loading()" :aria-busy="loading()">{{ loading() ? 'Sending…' : 'Send reset link' }}</button>
        <p class="sub">
          Remembered it? <StxLink to="/login">Sign in</StxLink>
        </p>
      </form>
    </div>
@endsection
